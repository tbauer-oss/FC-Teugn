{
  "openapi": "3.1.0",
  "info": {
    "title": "FC Teugn Jugend API",
    "version": "1.0.0",
    "description": "Produktiver REST-Vertrag für Vereins-, Mannschafts- und Spieltagsfunktionen. Schreibende Endpunkte erzwingen Rollen- und Mannschaftsgrenzen im Backend."
  },
  "servers": [
    {
      "url": "https://fc-teugn-backend.vercel.app",
      "description": "Produktion"
    },
    {
      "url": "http://localhost:4000",
      "description": "Lokale Entwicklung"
    }
  ],
  "tags": [
    {"name": "Auth"},
    {"name": "Datenschutz"},
    {"name": "Organisation"},
    {"name": "Spieler"},
    {"name": "Termine"},
    {"name": "Spiele"},
    {"name": "Training"},
    {"name": "Kommunikation"},
    {"name": "Import"},
    {"name": "Administration"}
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "API-Status",
        "responses": {"200": {"description": "API ist erreichbar"}}
      }
    },
    "/auth/consent-texts": {
      "get": {
        "tags": ["Auth"],
        "summary": "Aktive versionierte Einwilligungstexte",
        "responses": {"200": {"description": "Einwilligungstexte"}}
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrierung mit Mannschafts- und Rollenwunsch",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterRequest"}}}},
        "responses": {
          "201": {"description": "Registrierung angelegt"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "409": {"description": "E-Mail bereits registriert"}
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Anmelden",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}},
        "responses": {"200": {"description": "Access- und Refresh-Token"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh-Token rotieren",
        "responses": {"200": {"description": "Neue Tokens"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Eigenes Konto",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Benutzerkonto"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/auth/privacy/export": {
      "get": {
        "tags": ["Datenschutz"],
        "summary": "Personenbezogene Daten exportieren",
        "description": "Exportiert das eigene Konto und Daten rechtmäßig verknüpfter Kinder; der Zugriff wird auditiert.",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Strukturierter JSON-Export"}, "401": {"$ref": "#/components/responses/Unauthorized"}}
      }
    },
    "/auth/privacy/requests": {
      "get": {
        "tags": ["Datenschutz"],
        "summary": "Eigene Datenschutzanträge",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Antragsverlauf"}}
      }
    },
    "/auth/privacy/erasure-requests": {
      "post": {
        "tags": ["Datenschutz"],
        "summary": "Kontolöschung beantragen",
        "security": [{"bearerAuth": []}],
        "responses": {"201": {"description": "Antrag erfasst"}, "409": {"description": "Offener Antrag existiert"}}
      }
    },
    "/organization/public": {
      "get": {
        "tags": ["Organisation"],
        "summary": "Öffentliche sichere Vereinsstruktur",
        "responses": {"200": {"description": "Saisons, Altersklassen und Mannschaftsnamen ohne private Daten"}}
      }
    },
    "/organization/context": {
      "get": {
        "tags": ["Organisation"],
        "summary": "Sichtbarer Vereins- und Mannschaftskontext",
        "security": [{"bearerAuth": []}],
        "responses": {"200": {"description": "Berechtigter Teamkontext"}}
      }
    },
    "/organization/teams": {
      "post": {
        "tags": ["Organisation"],
        "summary": "Mannschaft anlegen",
        "security": [{"bearerAuth": []}],
        "responses": {"201": {"description": "Mannschaft angelegt"}, "403": {"$ref": "#/components/responses/Forbidden"}}
      }
    },
    "/organization/teams/{id}": {
      "patch": {
        "tags": ["Organisation"],
        "summary": "Mannschaftsstammdaten aktualisieren",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {"200": {"description": "Mannschaft aktualisiert"}, "403": {"$ref": "#/components/responses/Forbidden"}}
      },
      "delete": {
        "tags": ["Organisation"],
        "summary": "Mannschaft als Systemadministration löschen und Spieler freistellen",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {
          "200": {"description": "Mannschaft archiviert und Spieler als nicht zugeordnet markiert"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    },
    "/players": {
      "get": {"tags": ["Spieler"], "summary": "Berechtigte Spieler auflisten", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Spielerliste"}}},
      "post": {"tags": ["Spieler"], "summary": "Spieler anlegen", "security": [{"bearerAuth": []}], "responses": {"201": {"description": "Spieler angelegt"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/players/{id}": {
      "get": {"tags": ["Spieler"], "summary": "Geschütztes Spielerprofil", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Rollenabhängig gefiltertes Profil"}}},
      "put": {"tags": ["Spieler"], "summary": "Spieler aktualisieren", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Spieler aktualisiert"}}}
    },
    "/players/consent-templates": {
      "get": {"tags": ["Spieler", "Datenschutz"], "summary": "Aktuelle Einwilligungsvorlagen auflisten", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Versionierte Vorlagen mit granularen Auswahlmöglichkeiten"}}}
    },
    "/players/consent-templates/{type}/pdf": {
      "get": {"tags": ["Spieler", "Datenschutz"], "summary": "Leere Einwilligungsvorlage als PDF laden", "security": [{"bearerAuth": []}], "parameters": [{"name": "type", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "PDF-Vorlage"}}}
    },
    "/players/{id}/consents/{type}/sign": {
      "post": {"tags": ["Spieler", "Datenschutz"], "summary": "Granulare Einwilligung digital unterschreiben", "description": "Nur eine zugeordnete sorgeberechtigte Person darf unterschreiben. Textversion, Umfang, Signatur und SHA-256-Nachweis werden protokolliert.", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "type", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "Einwilligung und unveränderbarer Nachweis gespeichert"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/players/{id}/consents/{type}/revoke": {
      "post": {"tags": ["Spieler", "Datenschutz"], "summary": "Einwilligung mit Wirkung für die Zukunft widerrufen", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "type", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Widerruf protokolliert"}}}
    },
    "/players/{id}/consents/{type}/evidence/{evidenceId}/pdf": {
      "get": {"tags": ["Spieler", "Datenschutz"], "summary": "Signierten Einwilligungsnachweis als PDF laden", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}, {"name": "type", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "evidenceId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Privater PDF-Nachweis"}}}
    },
    "/events": {
      "get": {"tags": ["Termine"], "summary": "Termine auflisten", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Gefilterte Termine"}}},
      "post": {"tags": ["Termine"], "summary": "Termin oder Serie anlegen", "security": [{"bearerAuth": []}], "responses": {"201": {"description": "Termin angelegt"}}}
    },
    "/events/{id}/attendance": {
      "post": {"tags": ["Termine"], "summary": "Zu- oder Absage speichern", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Rückmeldung gespeichert"}}}
    },
    "/events/{id}/emergency-access": {
      "post": {"tags": ["Termine"], "summary": "Kurzlebigen Notfallzugriff nach Re-Authentifizierung ausstellen", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Notfalltoken mit fünf Minuten Gültigkeit"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/matches": {
      "get": {"tags": ["Spiele"], "summary": "Spiele auflisten", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Spiele"}}}
    },
    "/matches/{id}/lineup": {
      "put": {"tags": ["Spiele"], "summary": "Aufstellung und Formation speichern", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Aufstellung gespeichert"}}}
    },
    "/matches/{id}/ticker": {
      "get": {"tags": ["Spiele"], "summary": "Liveticker mit Sequenzstand lesen", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Tickerzustand"}}}
    },
    "/matches/{id}/ticker/events": {
      "post": {"tags": ["Spiele"], "summary": "Idempotentes Tickerkommando", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"201": {"description": "Ereignis erstellt"}, "200": {"description": "Bereits bekanntes Ereignis"}}}
    },
    "/matches/{id}/ticker/reset": {
      "post": {
        "tags": ["Spiele"],
        "summary": "Liveticker eines Spiels auf den Ausgangszustand zurücksetzen",
        "description": "Entfernt Uhr, Spielstand, Tickerereignisse und daraus berechnete Statistiken. Kader und Aufstellung bleiben erhalten. Nur für berechtigtes Vereinspersonal.",
        "security": [{"bearerAuth": []}],
        "parameters": [{"$ref": "#/components/parameters/Id"}],
        "responses": {
          "200": {"description": "Zurückgesetzter Tickerzustand"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"description": "Spiel nicht gefunden"}
        }
      }
    },
    "/trainings/{id}/plan": {
      "put": {"tags": ["Training"], "summary": "Trainingsplan speichern", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Trainingsplan"}}}
    },
    "/communications": {
      "get": {"tags": ["Kommunikation"], "summary": "Sichtbare Mitteilungen", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Mitteilungen"}}},
      "post": {"tags": ["Kommunikation"], "summary": "Mitteilung speichern", "security": [{"bearerAuth": []}], "responses": {"201": {"description": "Mitteilung"}}}
    },
    "/imports/competition/preview": {
      "post": {"tags": ["Import"], "summary": "CSV-/ICS-Import validieren und vorschauen", "security": [{"bearerAuth": []}], "responses": {"201": {"description": "Importvorschau"}}}
    },
    "/admin/privacy-requests": {
      "get": {"tags": ["Administration", "Datenschutz"], "summary": "Datenschutzanträge des Vereins", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Anträge"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/admin/privacy-requests/{id}": {
      "patch": {"tags": ["Administration", "Datenschutz"], "summary": "Prüfstatus und internen Vermerk aktualisieren", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"description": "Antrag aktualisiert"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    },
    "/admin/privacy-requests/{id}/complete-erasure": {
      "post": {"tags": ["Administration", "Datenschutz"], "summary": "Geprüftes Konto anonymisieren", "description": "Widerruft Sitzungen, entfernt aktive Zuordnungen und erhält notwendige Historie anonymisiert.", "security": [{"bearerAuth": []}], "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"204": {"description": "Anonymisierung abgeschlossen"}, "403": {"$ref": "#/components/responses/Forbidden"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "responses": {
      "BadRequest": {"description": "Validierungsfehler", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Unauthorized": {"description": "Authentifizierung erforderlich", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Forbidden": {"description": "Rolle oder Mannschaftszuordnung nicht ausreichend", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {"message": {"type": "string"}}
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string", "format": "password"}
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "password", "role", "teamIds", "privacyAccepted", "termsAccepted", "privacyTextVersionId", "termsTextVersionId"],
        "properties": {
          "firstName": {"type": "string"},
          "lastName": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string", "format": "password", "minLength": 8},
          "phone": {"type": ["string", "null"]},
          "role": {"type": "string", "enum": ["PARENT", "PLAYER", "COACH", "ASSISTANT_COACH", "TEAM_MANAGER"]},
          "teamIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "privacyAccepted": {"const": true},
          "termsAccepted": {"const": true},
          "privacyTextVersionId": {"type": "string"},
          "termsTextVersionId": {"type": "string"}
        }
      }
    }
  }
}
