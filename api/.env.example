DATABASE_URL=postgresql://user:password@localhost:5432/fc_teugn
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
EMERGENCY_ACCESS_SECRET=replace-with-a-third-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Web Push (generate once, for example with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@fc-teugn.de

# Conservative automatic cleanup of operational data. Domain records and
# consent/audit evidence require an approved club retention policy and are not
# deleted by this job.
RETENTION_SESSION_GRACE_DAYS=30
RETENTION_INACTIVE_PUSH_DAYS=180
RETENTION_READ_NOTIFICATION_DAYS=365
RETENTION_NOTIFICATION_MAX_DAYS=730
