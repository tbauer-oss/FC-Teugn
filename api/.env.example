DATABASE_URL=postgresql://user:password@localhost:5432/fc_teugn
# Nur in einer vollstaendig isolierten Demo-Instanz setzen. Im Demo-Modus gibt
# es bewusst keinen Fallback auf DATABASE_URL.
APP_ENVIRONMENT=development
DEMO_DATABASE_URL=
DEMO_SEED_PASSWORD=
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
EMERGENCY_ACCESS_SECRET=replace-with-a-third-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Transactional email (server only; never expose the key in Flutter/web/APK)
RESEND_API_KEY=
RESEND_ACCOUNT_FROM_EMAIL=FC Teugn Talents <account@fc-teugn-talents.de>
RESEND_SUPPORT_FROM_EMAIL=FC Teugn Talents Support <support@fc-teugn-talents.de>
RESEND_ACCOUNT_REPLY_TO=
RESEND_SUPPORT_REPLY_TO=
# Optional common fallback only for the reply-to address.
RESEND_REPLY_TO=

# Web Push (generate once, for example with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@fc-teugn.de

# Conservative automatic cleanup of operational data. Domain records and
# consent/audit evidence require an approved club retention policy and are not
# deleted by this job.
RETENTION_SESSION_GRACE_DAYS=30
RETENTION_INACTIVE_PUSH_DAYS=180
RETENTION_READ_NOTIFICATION_DAYS=365
RETENTION_NOTIFICATION_MAX_DAYS=730

# Messenger-Daten und -Medien werden nach 30 Tagen produktiv gelöscht. Der
# Datenbank-/Objektspeicher-Anbieter muss Sicherungen ebenfalls spätestens
# nach dieser Frist verwerfen; ein höherer Wert verhindert den Serverstart.
MESSENGER_BACKUP_RETENTION_DAYS=30
