  updatedAt      DateTime @updatedAt
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([provider, entityType, externalId])
  @@index([teamId, entityType])
  @@index([entityId])
}

model TeamTask {
  id             String         @id @default(cuid())
  teamId         String
  title          String
  description    String?
  category       String
  status         TeamTaskStatus @default(OPEN)
  assigneeUserId String?
  dueAt          DateTime?
  reminderAt     DateTime?
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  team           Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee       User?          @relation("TeamTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy      User           @relation("TeamTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teamId, status, dueAt])
  @@index([assigneeUserId, status])
}

model EquipmentItem {
  id          String                @id @default(cuid())
  teamId      String
  name        String
  category    String
  quantity    Int                   @default(1)
  status      EquipmentItemStatus   @default(ACTIVE)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignments EquipmentAssignment[]

  @@unique([teamId, name])
  @@index([teamId, status, category])
}

model EquipmentAssignment {
  id                 String        @id @default(cuid())
  equipmentItemId    String
  assignedToUserId   String?
  assignedToPlayerId String?
  assignedById       String
  quantity           Int           @default(1)
  assignedAt         DateTime      @default(now())
  dueAt              DateTime?
  returnedAt         DateTime?
  conditionOut       String?
  conditionIn        String?
  notes              String?
  equipmentItem      EquipmentItem @relation(fields: [equipmentItemId], references: [id], onDelete: Restrict)
  assignedToUser     User?         @relation("EquipmentAssignmentUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToPlayer   Player?       @relation(fields: [assignedToPlayerId], references: [id], onDelete: SetNull)
  assignedBy         User          @relation("EquipmentAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([equipmentItemId, returnedAt])
  @@index([assignedToUserId, returnedAt])
  @@index([assignedToPlayerId, returnedAt])
}

model ChecklistTemplate {
  id          String                  @id @default(cuid())
  teamId      String
  title       String
  category    String
  description String?
  isArchived  Boolean                 @default(false)
  createdById String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy   User                    @relation("ChecklistTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       ChecklistTemplateItem[]
  runs        ChecklistRun[]

  @@index([teamId, isArchived, category])
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  title      String
  position   Int
  isRequired Boolean           @default(true)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
}

model ChecklistRun {
  id          String             @id @default(cuid())
  teamId      String
  templateId  String?
  title       String
  category    String
  dueAt       DateTime?
  status      ChecklistRunStatus @default(ACTIVE)
  completedAt DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  template    ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("ChecklistRunCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       ChecklistRunItem[]

  @@index([teamId, status, dueAt])
}

model ChecklistRunItem {
  id             String       @id @default(cuid())
  checklistRunId String
  title          String
  position       Int
  isRequired     Boolean      @default(true)
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?
  completedById  String?
  checklistRun   ChecklistRun @relation(fields: [checklistRunId], references: [id], onDelete: Cascade)
  completedBy    User?        @relation("ChecklistRunItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([checklistRunId, position])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  teamId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId, createdAt])
}

model DataSubjectRequest {
  id           String                   @id @default(cuid())
  userId       String
  type         DataSubjectRequestType
  status       DataSubjectRequestStatus @default(RECEIVED)
  reason       String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  user         User                     @relation("DataSubjectRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?                    @relation("DataSubjectReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}
