datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CLUB_ADMIN
  YOUTH_DIRECTOR
  COACH
  ASSISTANT_COACH
  TEAM_MANAGER
  TRAINER_ADMIN
  TRAINER
  PARENT
  PLAYER
  READ_ONLY
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum RegistrationReviewStatus {
  NEW
  IN_REVIEW
  NEEDS_INFO
  COMPLETED
}

enum ConsentDocumentType {
  PRIVACY_POLICY
  TERMS_OF_USE
  PUSH_NOTIFICATIONS
}

enum EventType {
  TRAINING
  MATCH
  EVENT
}

enum EventCategory {
  TRAINING
  LEAGUE_MATCH
  FRIENDLY_MATCH
  CUP_MATCH
  TOURNAMENT
  INDOOR_TOURNAMENT
  FOOTBALL_FESTIVAL
  TEAM_MEETING
  PARENTS_MEETING
  CHRISTMAS_PARTY
  SEASON_CLOSING
  CLUB_EVENT
  TRIP
  PHOTO_SESSION
  SPECIAL_EVENT
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

enum EventVisibility {
  TEAM
  CLUB
  STAFF_ONLY
}

enum HomeAway {
  HOME
  AWAY
  NEUTRAL
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum AttendanceStatus {
  YES
  NO
  MAYBE
  UNKNOWN
}

enum CarpoolRequestStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum MatchKind {
  LEAGUE
  FRIENDLY
  CUP
  TOURNAMENT
  INDOOR
  FESTIVAL
  TEST
  INTERNAL
}

enum MatchStatus {
  PLANNED
  CONFIRMED
  POSTPONED
  CANCELLED
  LIVE
  HALF_TIME
  INTERRUPTED
  FINISHED
  RECORDED
}

enum NominationStatus {
  NOMINATED
  ON_CALL
  DECLINED
}

enum LineupStatus {
  DRAFT
  INTERNALLY_APPROVED
  PUBLISHED
  ARCHIVED
}

enum TickerStatus {
  NOT_STARTED
  LIVE
  PAUSED
  HALF_TIME
  INTERRUPTED
  FINISHED
}

enum TickerEventType {
  MATCH_START
  HOME_GOAL
  AWAY_GOAL
  PERIOD_END
  PERIOD_START
  INTERRUPTION
  RESUME
  SUBSTITUTION
  CARD
  INJURY
  PENALTY
  OWN_GOAL
  COMMENT
  CORRECTION
  EVENT_REVOKED
  MATCH_END
}

enum TrainingPhase {
  WARM_UP
  MAIN_PART
  GAME_FORM
  COOL_DOWN
}

enum TrainingAttendanceStatus {
  PRESENT
  EXCUSED
  UNEXCUSED
  INJURED
  LATE
  LEFT_EARLY
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementAudience {
  ALL_MEMBERS
  PARENTS
  PLAYERS
  STAFF
  INDIVIDUALS
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum NotificationCategory {
  EVENT
  EVENT_REMINDER
  ANNOUNCEMENT
  NOMINATION
  LINEUP
  LIVE_TICKER
  MATCH
  REGISTRATION
  URGENT
  SYSTEM
}

enum PitchConflictRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CALLBACK_REQUESTED
  CANCELLED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PushPlatform {
  WEB
  ANDROID
}

enum ImportFormat {
  CSV
  ICS
}

enum ImportJobStatus {
  PREVIEWED
  APPLIED
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
  CONFLICT
  INVALID
}

enum PlayerStatus {
  ACTIVE
  INJURED
  PAUSED
  LEFT
}

enum PlayerGender {
  MALE
  FEMALE
  DIVERSE
}

enum SeasonTransitionStatus {
  PREVIEWED
  APPLIED
  FAILED
}

enum DominantFoot {
  RIGHT
  LEFT
  BOTH
  UNKNOWN
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum DevelopmentCategory {
  TECHNIQUE
  TACTICS
  ATHLETIC
  SOCIAL
  GOALKEEPING
  GENERAL
}

enum NoteVisibility {
  STAFF_ONLY
  GUARDIANS_AND_STAFF
}

enum ConsentType {
  PHOTO
  TEAM_PHOTO
  TRANSPORT
  MEDICAL_DATA
  COMMUNICATION
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum FileAssetKind {
  PLAYER_PHOTO
  PLAYER_DOCUMENT
  TEAM_PHOTO
}

enum TeamType {
  COMPETITIVE
  DEVELOPMENT
  FESTIVAL
  RECREATIONAL
}

enum TeamGender {
  MIXED
  MALE
  FEMALE
}

enum TeamGameFormat {
  FOOTBALL_3
  FOOTBALL_4
  FOOTBALL_5
  FOOTBALL_7
  FOOTBALL_9
  FOOTBALL_11
}

enum DataSubjectRequestType {
  ERASURE
  RECTIFICATION
}

enum DataSubjectRequestStatus {
  RECEIVED
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum PlayerDocumentType {
  PHOTO_CONSENT
  PRIVACY_CONSENT
  PARTICIPATION_PERMISSION
  SWIMMING_PERMISSION
  DECLARATION
  TEAM_DOCUMENT
  OTHER
}

enum TeamTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum EquipmentItemStatus {
  ACTIVE
  MAINTENANCE
  LOST
  RETIRED
}

enum ChecklistRunStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Team {
  id                      String                    @id @default(cuid())
  ageGroupId              String
  teamNumber              Int                       @default(1)
  name                    String
  shortName               String?
  level                   String?
  teamType                TeamType                  @default(COMPETITIVE)
  gender                  TeamGender                @default(MIXED)
  gameFormat              TeamGameFormat            @default(FOOTBALL_7)
  periodCount             Int                       @default(2)
  periodMinutes           Int                       @default(30)
  defaultFormation        String?
  customFormations        String[]                  @default([])
  formationTemplates      Json                      @default("[]")
  birthYears              Int[]                     @default([])
  description             String?
  trainingLocation        String?
  trainingTimes           String[]                  @default([])
  trainingPartnerIds      String[]                  @default([])
  matchdayTimes            String[]                  @default([])
  seasonStartDate         DateTime?
  seasonEndDate           DateTime?
  indoorSeasonStartDate   DateTime?
  indoorSeasonEndDate     DateTime?
  indoorTrainingLocation  String?
  indoorTrainingTimes     String[]                  @default([])
  indoorTrainingPartnerIds String[]                 @default([])
  homeVenue               String?
  bfvTeamId               String?
  dfbnetTeamId            String?
  bfvTeamUrl              String?
  photoAssetId            String?                   @unique
  isActive                Boolean                   @default(true)
  deletedAt               DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  ageGroup                AgeGroup                  @relation(fields: [ageGroupId], references: [id])
  users                   User[]
  memberships             TeamMembership[]
  players                 Player[]
  events                  Event[]
  eventTargets            EventTargetTeam[]
  eventSeries             EventSeries[]
  auditLogs               AuditLog[]
  ruleProfiles            RuleProfile[]
  exercises               TrainingExercise[]
  announcements           AnnouncementTargetTeam[]
  importJobs              ImportJob[]
  externalRefs            ExternalReference[]
  playerSeasonAssignments PlayerSeasonAssignment[]
  registrationRequests    RegistrationTeamRequest[]
  tasks                   TeamTask[]
  equipmentItems          EquipmentItem[]
  checklistTemplates      ChecklistTemplate[]
  checklistRuns           ChecklistRun[]
  photoAsset              FileAsset?                @relation("TeamPhotoAsset", fields: [photoAssetId], references: [id], onDelete: SetNull)
  ownedFileAssets         FileAsset[]               @relation("TeamFileOwner")
  pitchConflictRequests   PitchConflictRequest[]
  defaultLineupPositions  TeamDefaultLineupPosition[]

  @@index([ageGroupId, isActive, deletedAt])
}

model Club {
  id                String             @id @default(cuid())
  name              String             @unique
  shortName         String
  primaryColor      String             @default("#176B87")
  accentColor       String             @default("#FFB000")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  seasons           Season[]
  seasonTransitions SeasonTransition[]
  players           Player[]
}

model Season {
  id                           String                   @id @default(cuid())
  clubId                       String
  name                         String
  startDate                    DateTime
  endDate                      DateTime
  isActive                     Boolean                  @default(false)
  recreationalTrainingLocation String?
  recreationalTrainingTimes    String[]                 @default([])
  seniorTrainingLocation       String?
  seniorTrainingTimes          String[]                 @default([])
  seniorMatchdayTimes           String[]                 @default([])
  approvedOccupancyConflictKeys String[]                @default([])
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  club                         Club                     @relation(fields: [clubId], references: [id])
  ageGroups                    AgeGroup[]
  playerAssignments            PlayerSeasonAssignment[]
  sourceTransitions            SeasonTransition[]       @relation("SeasonTransitionSource")
  targetTransitions            SeasonTransition[]       @relation("SeasonTransitionTarget")
  indoorOccupancyEntries       IndoorOccupancyEntry[]

  @@unique([clubId, name])
  @@index([clubId, isActive])
}

model IndoorOccupancyEntry {
  id                      String   @id @default(cuid())
  seasonId                String
  title                   String
  location                String   @default("Sporthalle")
  startAt                 DateTime
  endAt                   DateTime
  notes                   String?
  isRecurring             Boolean  @default(false)
  recurrenceWeekdays      Int[]    @default([])
  recurrenceIntervalWeeks Int      @default(1)
  recurrenceUntil         DateTime?
  createdById             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  season                  Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, startAt])
}

model AgeGroup {
  id        String   @id @default(cuid())
  seasonId  String
  name      String
  code      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  season    Season   @relation(fields: [seasonId], references: [id])
  teams     Team[]

  @@unique([seasonId, code])
  @@index([seasonId, sortOrder])
}

model User {
  id                           String                   @id @default(cuid())
  email                        String                   @unique
  password                     String
  name                         String
  firstName                    String?
  lastName                     String?
  phone                        String?
  role                         Role                     @default(PARENT)
  status                       AccountStatus            @default(PENDING)
  teamId                       String
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  team                         Team                     @relation(fields: [teamId], references: [id])
  parentLinks                  ParentPlayerLink[]       @relation("ParentLinks")
  memberships                  TeamMembership[]
  auditLogs                    AuditLog[]               @relation("AuditActor")
  developmentNotes             PlayerDevelopmentNote[]  @relation("DevelopmentAuthor")
  medicalUpdates               PlayerMedicalProfile[]   @relation("MedicalUpdatedBy")
  playerProfile                Player?                  @relation("PlayerAccount")
  eventSeries                  EventSeries[]            @relation("EventSeriesCreator")
  attendanceReplies            Attendance[]             @relation("AttendanceResponder")
  carpoolOffers                CarpoolOffer[]           @relation("CarpoolDriver")
  carpoolRequests              CarpoolPassenger[]       @relation("CarpoolRequester")
  eventReminders               EventReminder[]          @relation("EventReminderRecipient")
  calendarToken                String?                  @unique
  tickerEvents                 LiveTickerEvent[]        @relation("TickerEventAuthor")
  tickerDelegations            MatchTickerDelegate[]    @relation("TickerDelegate")
  grantedTickerDelegations     MatchTickerDelegate[]    @relation("TickerDelegateGranter")
  trainingPlans                TrainingPlan[]           @relation("TrainingPlanAuthor")
  assignedTrainingPlans        TrainingPlanCoach[]
  exercises                    TrainingExercise[]       @relation("ExerciseAuthor")
  authoredAnnouncements        Announcement[]           @relation("AnnouncementAuthor")
  announcementRecipients       AnnouncementRecipient[]
  announcementReads            AnnouncementRead[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  notificationPreferences      NotificationPreference[]
  notificationDeliveries       NotificationDelivery[]
  importJobs                   ImportJob[]
  seasonTransitions            SeasonTransition[]       @relation("SeasonTransitionActor")
  createdRuleProfiles          RuleProfile[]            @relation("RuleProfileCreator")
  approvedRuleProfiles         RuleProfile[]            @relation("RuleProfileApprover")
  registrationRequest          RegistrationRequest?
  registrationReviews          RegistrationRequest[]    @relation("RegistrationReviewer")
  registrationHistory          RegistrationHistory[]    @relation("RegistrationHistoryActor")
  requestedPitchConflicts      PitchConflictRequest[]    @relation("PitchConflictRequester")
  receivedPitchConflicts       PitchConflictRequest[]    @relation("PitchConflictRecipient")
  answeredPitchConflicts       PitchConflictRequest[]    @relation("PitchConflictResponder")
  consents                     UserConsent[]
  uploadedFileAssets           FileAsset[]              @relation("FileAssetUploader")
  refreshTokens                RefreshToken[]
  createdTeamTasks             TeamTask[]               @relation("TeamTaskCreator")
  assignedTeamTasks            TeamTask[]               @relation("TeamTaskAssignee")
  createdEquipmentAssignments  EquipmentAssignment[]    @relation("EquipmentAssignmentCreator")
  receivedEquipmentAssignments EquipmentAssignment[]    @relation("EquipmentAssignmentUser")
  createdChecklistTemplates    ChecklistTemplate[]      @relation("ChecklistTemplateCreator")
  createdChecklistRuns         ChecklistRun[]           @relation("ChecklistRunCreator")
  completedChecklistItems      ChecklistRunItem[]       @relation("ChecklistRunItemCompleter")
  dataSubjectRequests          DataSubjectRequest[]     @relation("DataSubjectRequester")
  reviewedDataSubjectRequests  DataSubjectRequest[]     @relation("DataSubjectReviewer")
  playerConsentEvidence        PlayerConsentEvidence[]  @relation("PlayerConsentSigner")
}

model RefreshToken {
  id           String    @id
  userId       String
  familyId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model ConsentTextVersion {
  id           String              @id @default(cuid())
  type         ConsentDocumentType
  version      Int
  title        String
  content      String
  checksum     String
  isActive     Boolean             @default(false)
  publishedAt  DateTime            @default(now())
  createdAt    DateTime            @default(now())
  userConsents UserConsent[]

  @@unique([type, version])
  @@index([type, isActive])
}

model UserConsent {
  id                   String             @id @default(cuid())
  userId               String
  consentTextVersionId String
  granted              Boolean
  grantedAt            DateTime           @default(now())
  revokedAt            DateTime?
  source               String             @default("REGISTRATION")
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentTextVersion   ConsentTextVersion @relation(fields: [consentTextVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, consentTextVersionId])
  @@index([userId, granted])
}

model RegistrationRequest {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  requestedRole     Role
  childName         String?
  relationship      GuardianRelationship?
  reviewStatus      RegistrationReviewStatus  @default(NEW)
  adminNote         String?
  applicantMessage  String?
  reviewedById      String?
  reviewedAt        DateTime?
  pushOptIn         Boolean                   @default(false)
  privacyAcceptedAt DateTime
  termsAcceptedAt   DateTime
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy        User?                     @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  requestedTeams    RegistrationTeamRequest[]
  history           RegistrationHistory[]

  @@index([reviewStatus, createdAt])
}

model RegistrationTeamRequest {
  id                    String              @id @default(cuid())
  registrationRequestId String
  teamId                String
  createdAt             DateTime            @default(now())
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)
  team                  Team                @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([registrationRequestId, teamId])
  @@index([teamId])
}

model RegistrationHistory {
  id                    String                    @id @default(cuid())
  registrationRequestId String
  actorId               String?
  fromStatus            AccountStatus?
  toStatus              AccountStatus?
  fromReviewStatus      RegistrationReviewStatus?
  toReviewStatus        RegistrationReviewStatus?
  note                  String?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  registrationRequest   RegistrationRequest       @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)
  actor                 User?                     @relation("RegistrationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([registrationRequestId, createdAt])
}

model TeamMembership {
  id        String        @id @default(cuid())
  userId    String
  teamId    String
  role      Role
  status    AccountStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, status])
}

model Player {
  id                   String                   @id @default(cuid())
  clubId               String
  teamId               String?
  userId               String?                  @unique
  firstName            String
  lastName             String
  preferredName        String?
  birthDate            DateTime?
  nationality          String?
  gender               PlayerGender?
  position             String?
  secondaryPosition    String?
  dominantFoot         DominantFoot             @default(UNKNOWN)
  shirtNumber          Int?
  passNumber           String?
  status               PlayerStatus             @default(ACTIVE)
  joinedAt             DateTime?
  photoUrl             String?
  photoAssetId         String?                  @unique
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  club                 Club                     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  team                 Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user                 User?                    @relation("PlayerAccount", fields: [userId], references: [id], onDelete: SetNull)
  parentLinks          ParentPlayerLink[]
  attendance           Attendance[]
  squadMembers         SquadMember[]
  medicalProfile       PlayerMedicalProfile?
  emergencyContacts    PlayerEmergencyContact[]
  developmentNotes     PlayerDevelopmentNote[]
  consents             PlayerConsent[]
  carpoolPassengers    CarpoolPassenger[]
  equipmentAssignments EquipmentAssignment[]
  lineupPositions      LineupPosition[]
  teamDefaultLineupPositions TeamDefaultLineupPosition[]
  tickerGoals          LiveTickerEvent[]        @relation("TickerScorer")
  tickerAssists        LiveTickerEvent[]        @relation("TickerAssist")
  matchStatistics      PlayerMatchStatistic[]
  seasonAssignments    PlayerSeasonAssignment[]
  photoAsset           FileAsset?               @relation("PlayerPhotoAsset", fields: [photoAssetId], references: [id], onDelete: SetNull)
  documents            PlayerDocument[]
  ownedFileAssets      FileAsset[]              @relation("PlayerFileOwner")

  @@index([clubId, teamId, status, lastName])
}

model FileAsset {
  id            String          @id @default(cuid())
  kind          FileAssetKind
  pathname      String          @unique
  storageUrl    String
  originalName  String
  contentType   String
  size          Int
  checksum      String
  isPrivate     Boolean         @default(true)
  uploadedById  String
  ownerPlayerId String?
  ownerTeamId   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  uploadedBy    User            @relation("FileAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  ownerPlayer   Player?         @relation("PlayerFileOwner", fields: [ownerPlayerId], references: [id], onDelete: SetNull)
  playerPhoto   Player?         @relation("PlayerPhotoAsset")
  ownerTeam     Team?           @relation("TeamFileOwner", fields: [ownerTeamId], references: [id], onDelete: SetNull)
  teamPhoto     Team?           @relation("TeamPhotoAsset")
  document      PlayerDocument?

  @@index([ownerPlayerId, kind, deletedAt])
  @@index([ownerTeamId, kind, deletedAt])
  @@index([uploadedById, createdAt])
}

model PlayerDocument {
  id          String             @id @default(cuid())
  playerId    String
  fileAssetId String             @unique
  type        PlayerDocumentType
  title       String
  version     Int                @default(1)
  status      ConsentStatus      @default(PENDING)
  validFrom   DateTime?
  validUntil  DateTime?
  grantedBy   String?
  grantedAt   DateTime?
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  player      Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset          @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([playerId, type, version])
  @@index([playerId, status, validUntil])
}

model PlayerSeasonAssignment {
  id         String       @id @default(cuid())
  playerId   String
  seasonId   String
  teamId     String
  status     PlayerStatus @default(ACTIVE)
  assignedAt DateTime     @default(now())
  endedAt    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  player     Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season     Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([playerId, seasonId])
  @@index([teamId, status])
}

model ParentPlayerLink {
  id                    String               @id @default(cuid())
  parentId              String
  playerId              String
  relationship          GuardianRelationship @default(GUARDIAN)
  isLegalGuardian       Boolean              @default(true)
  canPickup             Boolean              @default(true)
  receivesCommunication Boolean              @default(true)
  createdAt             DateTime             @default(now())
  parent                User                 @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  player                Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([parentId, playerId])
  @@index([playerId])
}

model PlayerMedicalProfile {
  id             String   @id @default(cuid())
  playerId       String   @unique
  allergies      String?
  medications    String?
  conditions     String?
  physicianName  String?
  physicianPhone String?
  emergencyNotes String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  updatedBy      User?    @relation("MedicalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PlayerEmergencyContact {
  id                 String   @id @default(cuid())
  playerId           String
  name               String
  relationship       String?
  phone              String
  priority           Int      @default(1)
  isAuthorizedPickup Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, priority])
}

model PlayerDevelopmentNote {
  id         String              @id @default(cuid())
  playerId   String
  authorId   String
  category   DevelopmentCategory @default(GENERAL)
  visibility NoteVisibility      @default(STAFF_ONLY)
  rating     Int?
  title      String
  notes      String
  observedAt DateTime            @default(now())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  player     Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  author     User                @relation("DevelopmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([playerId, observedAt])
}

model PlayerConsent {
  id              String                  @id @default(cuid())
  playerId        String
  type            ConsentType
  status          ConsentStatus           @default(PENDING)
  grantedBy       String?
  grantedAt       DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  note            String?
  templateVersion String?
  currentHash     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  player          Player                  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  evidence        PlayerConsentEvidence[]

  @@unique([playerId, type])
  @@index([playerId, status])
}

model PlayerConsentEvidence {
  id                         String        @id @default(cuid())
  consentId                  String
  signerId                   String
  action                     ConsentStatus
  templateVersion            String
  statement                  Json
  signatureData              Json?
  signerName                 String
  signerRole                 String
  guardianAuthorityConfirmed Boolean       @default(false)
  childAssentName            String?
  documentHash               String        @unique
  clientSignedAt             DateTime?
  createdAt                  DateTime      @default(now())
  consent                    PlayerConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)
