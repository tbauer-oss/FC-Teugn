datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CLUB_ADMIN
  YOUTH_DIRECTOR
  COACH
  ASSISTANT_COACH
  TEAM_MANAGER
  TRAINER_ADMIN
  TRAINER
  PARENT
  PLAYER
  READ_ONLY
}

enum AccountStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum EventType {
  TRAINING
  MATCH
  EVENT
}

enum AttendanceStatus {
  YES
  NO
  MAYBE
  UNKNOWN
}

enum PlayerStatus {
  ACTIVE
  INJURED
  PAUSED
  LEFT
}

enum DominantFoot {
  RIGHT
  LEFT
  BOTH
  UNKNOWN
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

enum DevelopmentCategory {
  TECHNIQUE
  TACTICS
  ATHLETIC
  SOCIAL
  GOALKEEPING
  GENERAL
}

enum NoteVisibility {
  STAFF_ONLY
  GUARDIANS_AND_STAFF
}

enum ConsentType {
  PHOTO
  TEAM_PHOTO
  TRANSPORT
  MEDICAL_DATA
  COMMUNICATION
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

model Team {
  id          String           @id @default(cuid())
  ageGroupId  String
  name        String
  shortName   String?
  level       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ageGroup    AgeGroup         @relation(fields: [ageGroupId], references: [id])
  users       User[]
  memberships TeamMembership[]
  players     Player[]
  events      Event[]
  auditLogs   AuditLog[]

  @@index([ageGroupId, isActive])
}

model Club {
  id           String   @id @default(cuid())
  name         String   @unique
  shortName    String
  primaryColor String   @default("#176B87")
  accentColor  String   @default("#FFB000")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  seasons      Season[]
}

model Season {
  id        String     @id @default(cuid())
  clubId    String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  club      Club       @relation(fields: [clubId], references: [id])
  ageGroups AgeGroup[]

  @@unique([clubId, name])
  @@index([clubId, isActive])
}

model AgeGroup {
  id        String   @id @default(cuid())
  seasonId  String
  name      String
  code      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  season    Season   @relation(fields: [seasonId], references: [id])
  teams     Team[]

  @@unique([seasonId, code])
  @@index([seasonId, sortOrder])
}

model User {
  id               String                  @id @default(cuid())
  email            String                  @unique
  password         String
  name             String
  phone            String?
  role             Role                    @default(PARENT)
  status           AccountStatus           @default(PENDING)
  teamId           String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  team             Team                    @relation(fields: [teamId], references: [id])
  parentLinks      ParentPlayerLink[]      @relation("ParentLinks")
  memberships      TeamMembership[]
  auditLogs        AuditLog[]              @relation("AuditActor")
  developmentNotes PlayerDevelopmentNote[] @relation("DevelopmentAuthor")
  medicalUpdates   PlayerMedicalProfile[]  @relation("MedicalUpdatedBy")
  playerProfile    Player?                 @relation("PlayerAccount")
}

model TeamMembership {
  id        String        @id @default(cuid())
  userId    String
  teamId    String
  role      Role
  status    AccountStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, status])
}

model Player {
  id                String                   @id @default(cuid())
  teamId            String
  userId            String?                  @unique
  firstName         String
  lastName          String
  preferredName     String?
  birthDate         DateTime?
  nationality       String?
  position          String?
  secondaryPosition String?
  dominantFoot      DominantFoot             @default(UNKNOWN)
  shirtNumber       Int?
  status            PlayerStatus             @default(ACTIVE)
  joinedAt          DateTime?
  photoUrl          String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  team              Team                     @relation(fields: [teamId], references: [id])
  user              User?                    @relation("PlayerAccount", fields: [userId], references: [id], onDelete: SetNull)
  parentLinks       ParentPlayerLink[]
  attendance        Attendance[]
  squadMembers      SquadMember[]
  medicalProfile    PlayerMedicalProfile?
  emergencyContacts PlayerEmergencyContact[]
  developmentNotes  PlayerDevelopmentNote[]
  consents          PlayerConsent[]

  @@index([teamId, status, lastName])
}

model ParentPlayerLink {
  id                    String               @id @default(cuid())
  parentId              String
  playerId              String
  relationship          GuardianRelationship @default(GUARDIAN)
  isLegalGuardian       Boolean              @default(true)
  canPickup             Boolean              @default(true)
  receivesCommunication Boolean              @default(true)
  createdAt             DateTime             @default(now())
  parent                User                 @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  player                Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([parentId, playerId])
  @@index([playerId])
}

model PlayerMedicalProfile {
  id             String   @id @default(cuid())
  playerId       String   @unique
  allergies      String?
  medications    String?
  conditions     String?
  physicianName  String?
  physicianPhone String?
  emergencyNotes String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  updatedBy      User?    @relation("MedicalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PlayerEmergencyContact {
  id                 String   @id @default(cuid())
  playerId           String
  name               String
  relationship       String?
  phone              String
  priority           Int      @default(1)
  isAuthorizedPickup Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, priority])
}

model PlayerDevelopmentNote {
  id         String              @id @default(cuid())
  playerId   String
  authorId   String
  category   DevelopmentCategory @default(GENERAL)
  visibility NoteVisibility      @default(STAFF_ONLY)
  rating     Int?
  title      String
  notes      String
  observedAt DateTime            @default(now())
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  player     Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  author     User                @relation("DevelopmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([playerId, observedAt])
}

model PlayerConsent {
  id        String        @id @default(cuid())
  playerId  String
  type      ConsentType
  status    ConsentStatus @default(PENDING)
  grantedBy String?
  grantedAt DateTime?
  expiresAt DateTime?
  revokedAt DateTime?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  player    Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, type])
  @@index([playerId, status])
}

model Event {
  id                  String        @id @default(cuid())
  teamId              String
  type                EventType
  title               String
  startAt             DateTime
  endAt               DateTime?
  location            String
  description         String?
  attendanceFinalized Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  team                Team          @relation(fields: [teamId], references: [id])
  attendance          Attendance[]
  matchDetails        MatchDetails?
  squads              Squad[]
}

model MatchDetails {
  id          String   @id @default(cuid())
  eventId     String   @unique
  opponent    String
  isHome      Boolean  @default(true)
  competition String?
  notes       String?
  ourGoals    Int?
  theirGoals  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id])
}

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  playerId  String
  status    AttendanceStatus @default(UNKNOWN)
  updatedAt DateTime         @updatedAt
  event     Event            @relation(fields: [eventId], references: [id])
  player    Player           @relation(fields: [playerId], references: [id])

  @@unique([eventId, playerId])
}

model Squad {
  id        String        @id @default(cuid())
  eventId   String
  name      String?
  formation String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  event     Event         @relation(fields: [eventId], references: [id])
  members   SquadMember[]
}

model SquadMember {
  id        String   @id @default(cuid())
  squadId   String
  playerId  String
  createdAt DateTime @default(now())
  squad     Squad    @relation(fields: [squadId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])

  @@unique([squadId, playerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  teamId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId, createdAt])
}
